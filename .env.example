# ==========================================================
# E-Medical Sehore – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==========================================================

# ----------------------------------------------------------
# DATABASE
# ----------------------------------------------------------
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# ----------------------------------------------------------
# AUTHENTICATION
# ----------------------------------------------------------
# Generate a secure 32+ char secret: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# ----------------------------------------------------------
# GOOGLE OAUTH (optional)
# ----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# ----------------------------------------------------------
# RAZORPAY (Test Mode)
# Get keys from: https://dashboard.razorpay.com/app/keys
# ----------------------------------------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ----------------------------------------------------------
# CLOUDFLARE R2 (Production file storage)
# ----------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=your_bucket_name
# Public URL for R2 bucket (or custom domain)
R2_PUBLIC_URL=https://your-r2-public-domain.example

# ----------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------
PUBLIC_APP_URL=http://localhost:5173
NODE_ENV=development

# ----------------------------------------------------------
# ADMIN SEED (used by seed script)
# ----------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-unique-password

# ----------------------------------------------------------
# OPTIONAL – Redis (for session caching)
# ----------------------------------------------------------
# REDIS_URL=redis://localhost:6379
